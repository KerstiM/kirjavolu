{
  // Kirjavõlu on Cloudflare Workers: the app from dist/ plus the API under /api/.
  // Deployed by .github/workflows/cloudflare.yml; locally `npm run worker:dev`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kirjavolu",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Routes such as /looming/… are the app's own; a refresh gets index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // The AI sample letter (/api/proovikiri): counters per day, a burst limit per address and
  // a daily cap for everyone. The API key is the secret ANTHROPIC_API_KEY, set in the dashboard.
  "kv_namespaces": [{ "binding": "USAGE", "id": "c72ed1a423094ef4a8498ec864e08f58" }],
  "ratelimits": [{ "name": "SAMPLE_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }],
  "vars": { "AI_DAILY_LIMIT": "300" },
  // Cloudflare creates the DNS records and certificates for these itself.
  "routes": [
    { "pattern": "kirjavolu.ee", "custom_domain": true },
    { "pattern": "www.kirjavolu.ee", "custom_domain": true }
  ]
}
